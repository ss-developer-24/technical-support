# Environment Configuration for Backend

# Google Cloud Configuration
GCP_PROJECT_ID=YOUR_PROJECT_ID
GCS_BUCKET_NAME=YOUR_BUCKET_NAME
VERTEX_AI_LOCATION=YOUR_VERTEX_AI_LOCATION

# Google AI API Key (for Google ADK/Gemini)
GOOGLE_API_KEY=YOUR_GOOGLE_API_KEY
#255507724672-compute@developer.gserviceaccount.com

# Tavily API Key (for web search)
TAVILY_API_KEY=YOUR_TAVILY_API_KEY

# Agent Model Configuration
ORCHESTRATOR_MODEL=gemini-2.5-flash-lite
RESEARCHER_MODEL=gemini-2.5-flash-lite
REVIEWER_MODEL=gemini-2.5-flash-lite

# RAG Configuration
ENABLE_RAG=true

# Server Configuration
PORT=8000
LOG_LEVEL=INFO
